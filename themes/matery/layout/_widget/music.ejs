<link rel="stylesheet" href="<%- theme.jsDelivr.url %><%- url_for(theme.libs.css.aplayer) %>">
<style>
    .aplayer .aplayer-lrc p {
        <%if(theme.music.hideLrc){%>
        display: none;
        <%}%>
        font-size: 12px;
        font-weight: 700;
        line-height: 16px !important;
    }

    .aplayer .aplayer-lrc p.aplayer-lrc-current {
        <%if(theme.music.hideLrc){%>
        display: none;
        <%}%>
        font-size: 15px;
        color: <%- theme.music.theme %>;
    }

    <%if(theme.music.autoHide){%>
    .aplayer.aplayer-fixed.aplayer-narrow .aplayer-body {
        left: -66px !important;
    }

    .aplayer.aplayer-fixed.aplayer-narrow .aplayer-body:hover {
        left: 0px !important;
    }

    <%}%>
</style>
<div class="<% if(!theme.music.fixed) { %>music-player<% } %>">
    <% if (!theme.music.fixed && theme.music.title.enable) { %>
        <div class="title center-align">
            <i class="fas fa-music"></i>&nbsp;&nbsp;<%- theme.music.title.show %>
        </div>
    <% } %>
    <div class="row">
        <meting-js class="col l8 offset-l2 m10 offset-m1 s12"
                   server="<%- theme.music.server %>"
                   type="<%- theme.music.type %>"
                   id="<%- theme.music.id %>"
                   fixed='<%- theme.music.fixed ? 'true' : 'false' %>'
                   autoplay='<%- theme.music.autoplay === true %>'
                   theme='<%- theme.music.theme %>'
                   loop='<%- theme.music.loop %>'
                   order='<%- theme.music.order %>'
                   preload='<%- theme.music.preload %>'
                   volume='<%- Number(theme.music.volume) %>'
                   list-folded='<%- theme.music.listFolded ? 'true' : 'false' %>'
        >
        </meting-js>
        <div id="musicStatus" role="status" aria-live="polite" style="display:none;position:fixed;left:8px;bottom:72px;z-index:100;font-size:12px;background:#fff;color:#555;padding:6px 10px;border-radius:4px"></div>
        <script>
            (function () {
                var player = document.querySelector('meting-js');
                var status = document.getElementById('musicStatus');
                if (!player || !status) return;
                var state = {failed: false, attempts: 0};
                try { state = JSON.parse(sessionStorage.getItem('blog-music-state') || 'null') || state; } catch (_) {}
                if (state.failed) {
                    status.textContent = '音乐服务暂时不可用，请稍后重试。';
                    status.style.display = 'block';
                }
                function persistState() {
                    try { sessionStorage.setItem('blog-music-state', JSON.stringify(state)); } catch (_) {}
                }
                window.addEventListener('storage', function (event) {
                    if (event.key === 'blog-music-state' && event.newValue) {
                        try { state = JSON.parse(event.newValue); } catch (_) {}
                    }
                });
                player.addEventListener('error', function () {
                    state.attempts += 1;
                    if (state.attempts >= 3) {
                        state.failed = true;
                        status.textContent = '音乐服务暂时不可用，请稍后重试。';
                        status.style.display = 'block';
                    }
                    persistState();
                });
                player.addEventListener('loadeddata', function () {
                    state.failed = false;
                    state.attempts = 0;
                    status.style.display = 'none';
                    persistState();
                });
            })();
        </script>
    </div>
</div>

<script src="<%- theme.jsDelivr.url %><%- url_for(theme.libs.js.aplayer) %>"></script>
<script src="https://cdn.jsdelivr.net/npm/meting@2/dist/Meting.min.js"></script>
